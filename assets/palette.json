{
  "name": "Felipe Carvajal Brown — Brand Palette",
  "version": "1.0.0",
  "description": "Official color tokens for fcarvajalbrown.cl, business cards, and all branded assets",
  "colors": {
    "background": {
      "primary":   { "hex": "#1a1a1a", "use": "Main dark background, card front" },
      "secondary": { "hex": "#111111", "use": "Deeper dark, footer" },
      "surface":   { "hex": "#242424", "use": "Cards, nav on dark" },
      "light":     { "hex": "#f9f9f9", "use": "Card back, light sections" },
      "white":     { "hex": "#ffffff", "use": "Pure white backgrounds" }
    },
    "text": {
      "primary":   { "hex": "#f5f5f5", "use": "Main text on dark" },
      "secondary": { "hex": "#e0e0e0", "use": "Body text on dark" },
      "muted":     { "hex": "#777777", "use": "Subtitles, metadata" },
      "faint":     { "hex": "#444444", "use": "Contact lines on white" },
      "dark":      { "hex": "#1a1a1a", "use": "Text on white/light" }
    },
    "accent": {
      "purple":      { "hex": "#8b7cf6", "use": "Primary accent — links, highlights, CTA, card border" },
      "purple_deep": { "hex": "#7b6fe0", "use": "Hover state, active links" },
      "purple_faint":{ "hex": "#2a2040", "use": "Accent backgrounds, subtle highlight" }
    },
    "border": {
      "dark":   { "hex": "#2e2e2e", "use": "Dividers on dark bg" },
      "light":  { "hex": "#e0e0e0", "use": "Dividers on light bg" },
      "accent": { "hex": "#8b7cf6", "use": "Featured card border, accent line" }
    },
    "semantic": {
      "success": { "hex": "#4caf7c", "use": "Available spots indicator" },
      "danger":  { "hex": "#e85c4a", "use": "Taken spots indicator" },
      "warning": { "hex": "#e8c96e", "use": "Launch badge" }
    }
  },
  "typography": {
    "display": { "family": "DM Serif Display", "weights": [400], "use": "Hero headlines, italics" },
    "body":    { "family": "Jost",             "weights": [300, 400, 700], "use": "All UI, monogram, body" },
    "mono":    { "family": "DM Mono",          "weights": [400, 500], "use": "Prices, labels, tags" }
  },
  "spacing": {
    "card_bleed": "3mm",
    "card_safe":  "5mm",
    "card_size":  "90x50mm"
  }
}
