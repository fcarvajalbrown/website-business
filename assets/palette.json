{
  "name": "Felipe Carvajal Brown — Brand Palette",
  "version": "2.0.0",
  "description": "Official color tokens for fcarvajalbrown.cl, business cards, and all branded assets — Warm Amber + Cream",
  "colors": {
    "background": {
      "primary":   { "hex": "#15130f", "use": "Main dark background, card front" },
      "secondary": { "hex": "#100e0b", "use": "Deeper dark, footer" },
      "surface":   { "hex": "#211d17", "use": "Cards, nav on dark" },
      "light":     { "hex": "#f4efe6", "use": "Cream — card back, light sections" },
      "white":     { "hex": "#ffffff", "use": "Pure white backgrounds" }
    },
    "text": {
      "primary":   { "hex": "#f4efe6", "use": "Main text on dark" },
      "secondary": { "hex": "#ddd6c9", "use": "Body text on dark" },
      "muted":     { "hex": "#8a8175", "use": "Subtitles, metadata" },
      "faint":     { "hex": "#3a352d", "use": "Hairlines, faint marks on dark" },
      "dark":      { "hex": "#15130f", "use": "Text on cream/light" }
    },
    "accent": {
      "amber":       { "hex": "#e8a33d", "use": "Primary accent — links, highlights, CTA, card border" },
      "amber_deep":  { "hex": "#d08f2e", "use": "Hover state, active links, accent on cream" },
      "amber_faint": { "hex": "#2a2218", "use": "Accent backgrounds, subtle highlight" }
    },
    "border": {
      "dark":   { "hex": "#2c271f", "use": "Dividers on dark bg" },
      "light":  { "hex": "#ddd6c9", "use": "Dividers on cream bg" },
      "accent": { "hex": "#e8a33d", "use": "Featured card border, accent line" }
    },
    "semantic": {
      "success": { "hex": "#6fb98f", "use": "Available spots indicator" },
      "danger":  { "hex": "#e85c4a", "use": "Taken spots indicator" },
      "warning": { "hex": "#e8c96e", "use": "Launch badge" }
    }
  },
  "typography": {
    "display": { "family": "DM Serif Display", "weights": [400], "use": "Hero headlines, italics" },
    "body":    { "family": "Jost",             "weights": [300, 400, 700], "use": "All UI, monogram, body" },
    "mono":    { "family": "DM Mono",          "weights": [400, 500], "use": "Prices, labels, tags" }
  },
  "spacing": {
    "card_bleed": "3mm",
    "card_safe":  "5mm",
    "card_size":  "90x50mm"
  }
}
